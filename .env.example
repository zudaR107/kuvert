# Kuvert — Budget Service

# Docker Compose build-time browser targets. SCHLUSSEL_WEB_URL must be the
# hosted Schlüssel frontend used for PKCE login/account navigation, not the
# internal http://schlussel:4000 API address.
SCHLUSSEL_WEB_URL=https://auth.localhost
SCHLOSS_URL=https://localhost

# Kuvert API
DATABASE_PATH=/data/kuvert.db
SCHLUSSEL_JWKS_URL=http://schlussel:4000/.well-known/jwks.json
JWT_ISSUER=schlussel
ALLOWED_ORIGINS=http://localhost:5174

# Docker Compose maps this service-specific value to ALLOWED_ORIGINS inside
# the backend container. Platform ZIP collection calls the internal
# /exports/me endpoint server-to-server and does not depend on browser CORS.
KUVERT_ALLOWED_ORIGINS=https://localhost,https://kuvert.localhost,https://auth.localhost

# /exports/me uses the same JWKS and issuer for access and export-delegation
# JWTs. Kuvert has no export signing secret, artifact directory, or ZIP quota.

# Notification outbox delivery to Glocke (see backend/src/notifications/outbox.ts).
# KUVERT_TO_GLOCKE_HMAC_SECRET must match Glocke's own
# GLOCKE_SOURCE_SECRET_KUVERT exactly, and must be distinct from every
# other service's own HMAC secret - generate with e.g. `openssl rand -hex 32`.
# Left unset, goal-completion events still get recorded but queue up
# undelivered rather than crashing the service. Set both credential values
# together; a partial configuration fails startup.
GLOCKE_BASE_URL=http://glocke-backend:3004
KUVERT_TO_GLOCKE_HMAC_KEY_ID=kuvert-v1
KUVERT_TO_GLOCKE_HMAC_SECRET=replace-with-at-least-32-random-bytes
GLOCKE_OUTBOX_RETENTION_MS=2147483647

# When running Vite directly, set VITE_SCHLUSSEL_URL and VITE_SCHLOSS_URL in
# frontend/.env to the corresponding browser origins. Docker Compose derives
# those build arguments from SCHLUSSEL_WEB_URL and SCHLOSS_URL above.
