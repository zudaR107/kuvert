# Kuvert — Budget Service

# Docker Compose build-time browser targets. SCHLUSSEL_WEB_URL must be the
# hosted Schlüssel frontend used for PKCE login/account navigation, not the
# internal http://schlussel:4000 API address.
SCHLUSSEL_WEB_URL=https://auth.localhost
SCHLOSS_URL=https://localhost

# Kuvert API
DATABASE_PATH=/data/kuvert.db
SCHLUSSEL_JWKS_URL=http://schlussel:4000/.well-known/jwks.json
JWT_ISSUER=schlussel
ALLOWED_ORIGINS=http://localhost:5174

# Docker Compose maps this service-specific value to ALLOWED_ORIGINS inside
# the backend container. Keep the hosted auth browser origin: Schlüssel's
# account page calls Kuvert's scoped GET /export with the shared bearer token.
KUVERT_ALLOWED_ORIGINS=https://localhost,https://kuvert.localhost,https://auth.localhost

# When running Vite directly, set VITE_SCHLUSSEL_URL and VITE_SCHLOSS_URL in
# frontend/.env to the corresponding browser origins. Docker Compose derives
# those build arguments from SCHLUSSEL_WEB_URL and SCHLOSS_URL above.
